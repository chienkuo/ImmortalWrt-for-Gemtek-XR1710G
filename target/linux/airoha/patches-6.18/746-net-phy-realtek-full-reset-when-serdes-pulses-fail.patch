From: zhangjianguo <janegle@gmail.com>
Subject: [PATCH] net: phy: realtek: full PHY reset when SerDes pulses fail

Cable hotplug can leave the RTL8261BE host-side USXGMII AN engine stuck:
copper negotiates 10G but the PCS receives no partner word
(AN_STATS_0 stays zero) and the PHY drops the copper link ~40ms later.
The flow_s SerDes pulses from the RTK SerDes retry loop cannot restart
that engine, so the port never comes back until a reboot or an interface
restart.

Escalate to a full PHY reset (vendor 0x145 reset, patch table reload and
SDS reconfiguration - the config_init() sequence) after 5 failed pulses,
bounded to 3 full resets to avoid an infinite recovery loop.

Signed-off-by: zhangjianguo <janegle@gmail.com>
---

When the pulse ladder and the full PHY resets cannot recover the carrier,
the port can stay wedged indefinitely: copper AN keeps running and the
peer locks onto our signal (half-open link), but the AN7581 PCS/USXGMII
lane never locks onto the peer. The PHY-side ladder cannot un-wedge it;
the only known fix is a full interface re-init (phylink restart ->
pcs_config -> JCPLL VCO recal), which is also why a reboot recovered the
port.

Add an in-driver lane restart:
- anchor on the pulse episode: if a flow_s pulse happened at least 30 s
  ago and the netdev carrier is still down, schedule a deferred
  phylink_stop()/phylink_start() (rtnl + workqueue, no lock nesting with
  the phylib state machine), re-running pcs_config and the JCPLL VCO
  recal. The brief copper link-ups of the wedge are too short (ms range)
  for the 1 s read_status poll to count, so the trigger is carrier-based
  instead;
- rate-limit the restart to one per 90 s (cooldown), so a recovery
  attempt that does not stick still leaves the mechanism armed for the
  next episode - a boolean latch proved to stay stuck after a failed
  recovery and blocked all later recoveries;
- the ladder's terminal state ("recovery failed after N full resets")
  also schedules the restart as a backstop.
--- a/drivers/net/phy/realtek/realtek.h
+++ b/drivers/net/phy/realtek/realtek.h
@@ -20,6 +20,12 @@
 	enum rtl826x_rtk_serdes_state rtk_serdes_state;
 	u32 rtk_serdes_pulse_count;
 	u8 rtk_serdes_carrier_polls;
+	u8 rtk_serdes_full_resets;
+	bool rtk_carrier_ok;
+	unsigned long rtk_carrier_up_ts;
+	unsigned long rtk_pulse_start_ts;
+	unsigned long rtk_lane_restart_ts;
+	struct delayed_work lane_restart_work;
 	bool enable_pma_low_power:1;
 	bool patch_rtk_serdes:1;
 	struct phy_device *phydev;
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -13,6 +13,10 @@
 #include <linux/firmware.h>
 #include <linux/of.h>
 #include <linux/phy.h>
+#include <linux/phylink.h>
+#include <linux/rtnetlink.h>
+
+static void rtl826x_lane_restart_work(struct work_struct *work);
 #include <linux/phy/phy-common-props.h>
 #include <linux/pm_wakeirq.h>
 #include <linux/netdevice.h>
@@ -3354,6 +3358,7 @@
 	struct rtl826x_priv *priv = data;
 
 	cancel_delayed_work_sync(&priv->sds_work);
+	cancel_delayed_work_sync(&priv->lane_restart_work);
 }
 
 static int rtl826x_probe(struct phy_device *phydev)
@@ -3375,6 +3380,8 @@
 	phydev->priv = priv;
 
 	INIT_DELAYED_WORK(&priv->sds_work, rtl826x_sds_reset_work);
+	INIT_DELAYED_WORK(&priv->lane_restart_work,
+			  rtl826x_lane_restart_work);
 	ret = devm_add_action_or_reset(dev, rtl826x_cancel_sds_work, priv);
 	if (ret)
 		return ret;
@@ -3645,6 +3652,54 @@
 	return genphy_c45_check_and_restart_aneg(phydev, changed);
 }
 
+static int rtl826x_rtk_serdes_full_reset(struct phy_device *phydev)
+{
+	struct rtl826x_priv *priv = phydev->priv;
+	unsigned int tries = 0;
+	int ret;
+
+	phydev_info(phydev,
+		    "RTK SerDes pulses failed to recover carrier, full PHY reset\n");
+
+	/* Vendor 0x145 reset, then reload the patch table and SDS
+	 * configuration - the same sequence config_init() runs. A stuck
+	 * host-side USXGMII AN engine after cable hotplug needs this full
+	 * reset; the flow_s pulses alone cannot restart it.
+	 */
+	ret = phy_set_bits_mmd(phydev, MDIO_MMD_VEND1, 0x145, BIT(0));
+	if (ret < 0)
+		return ret;
+
+	do {
+		msleep(30);
+		tries++;
+		ret = phy_clear_bits_mmd(phydev, MDIO_MMD_VEND1, 0x145, BIT(0));
+	} while (ret < 0 && tries <= 5);
+	if (ret < 0)
+		return ret;
+
+	msleep(30);
+
+	ret = rtlgen_phy_patch(phydev);
+	if (ret)
+		return ret;
+
+	ret = rtl826x_config_sds_mode(phydev);
+	if (ret)
+		return ret;
+
+	ret = rtl826x_config_serdes_polarity(phydev);
+	if (ret)
+		return ret;
+
+	priv->rtk_serdes_pulse_count = 0;
+	priv->rtk_serdes_carrier_polls = 0;
+	priv->rtk_serdes_full_resets++;
+	priv->rtk_serdes_state = RTL826X_RTK_SERDES_PULSE;
+
+	return 0;
+}
+
 static int rtl826x_rtk_serdes_pulse(struct phy_device *phydev)
 {
 	struct rtl826x_priv *priv = phydev->priv;
@@ -3668,6 +3723,36 @@
 	return 0;
 }
 
+static void rtl826x_lane_restart_work(struct work_struct *work)
+{
+	struct rtl826x_priv *priv = container_of(work, struct rtl826x_priv,
+						 lane_restart_work.work);
+	struct phy_device *phydev = priv->phydev;
+	struct phylink *pl;
+
+	rtnl_lock();
+	if (phydev->attached_dev && phydev->phylink) {
+		pl = phydev->phylink;
+		phydev_info(phydev,
+			    "RTK SerDes lane wedged, restarting phylink (pcs_config + JCPLL recal)\n");
+		phylink_stop(pl);
+		phylink_start(pl);
+	}
+	rtnl_unlock();
+}
+
+/* Rate-limit the restart to once per 90 s: a failed recovery must not
+ * latch the guard and block all later episodes.
+ */
+static void rtl826x_schedule_lane_restart(struct rtl826x_priv *priv)
+{
+	if (time_before(jiffies, priv->rtk_lane_restart_ts + 90 * HZ))
+		return;
+
+	priv->rtk_lane_restart_ts = jiffies;
+	schedule_delayed_work(&priv->lane_restart_work, msecs_to_jiffies(200));
+}
+
 static int rtl826x_read_status(struct phy_device *phydev)
 {
 	struct rtl826x_priv *priv = phydev->priv;
@@ -3709,6 +3794,24 @@
 	if (!priv || !priv->patch_rtk_serdes)
 		return 0;
 
+	/* A flow_s pulse that cannot produce a stable carrier within
+	 * 30 s is the PCS lane wedge signature (brief copper link-ups
+	 * are too short for the 1 s poll to count reliably). The
+	 * pulse/full-reset ladder cannot un-wedge the AN7581
+	 * PCS/USXGMII lane; a phylink restart (pcs_config -> JCPLL VCO
+	 * recal) does.
+	 */
+	if (priv->rtk_serdes_pulse_count && !priv->rtk_pulse_start_ts)
+		priv->rtk_pulse_start_ts = jiffies;
+	else if (!priv->rtk_serdes_pulse_count)
+		priv->rtk_pulse_start_ts = 0;
+
+	if (priv->rtk_pulse_start_ts &&
+	    time_after(jiffies, priv->rtk_pulse_start_ts + 30 * HZ) &&
+	    !(phydev->attached_dev &&
+	      netif_carrier_ok(phydev->attached_dev)))
+		rtl826x_schedule_lane_restart(priv);
+
 	if (!aneg_done) {
 		ret = genphy_c45_aneg_done(phydev);
 		if (ret < 0)
@@ -3776,6 +3879,7 @@
 			phydev_info(phydev,
 				    "RTK SerDes carrier recovered after %u flow_s pulse(s)\n",
 				    priv->rtk_serdes_pulse_count);
+			priv->rtk_pulse_start_ts = 0;
 			priv->rtk_serdes_state = RTL826X_RTK_SERDES_IDLE;
 			return 0;
 		}
@@ -3786,6 +3890,23 @@
 
 		priv->rtk_serdes_carrier_polls = 0;
 
+		if (priv->rtk_serdes_pulse_count >= 5) {
+			/* Repeated pulses did not recover the PCS carrier:
+			 * the host-side AN engine is stuck. Escalate to a
+			 * full PHY reset, but stop after a few attempts to
+			 * avoid an infinite recovery loop.
+			 */
+			if (priv->rtk_serdes_full_resets < 3)
+				return rtl826x_rtk_serdes_full_reset(phydev);
+
+			phydev_err(phydev,
+				   "RTK SerDes recovery failed after %u full resets\n",
+				   priv->rtk_serdes_full_resets);
+			rtl826x_schedule_lane_restart(priv);
+			priv->rtk_serdes_state = RTL826X_RTK_SERDES_IDLE;
+			return 0;
+		}
+
 		return rtl826x_rtk_serdes_pulse(phydev);
 	case RTL826X_RTK_SERDES_IDLE:
 		return 0;
