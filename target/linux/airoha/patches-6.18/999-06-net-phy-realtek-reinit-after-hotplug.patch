From: zhangjianguo <janegle@gmail.com>
Subject: [PATCH] net: phy: realtek: re-init RTL826x after a hot-plug link loss

Unplugging the cable from the XR1710G leaves the RTL8261BE firmware in a
state the RTK SerDes flow_s pulse ladder cannot repair. On the next
replug autonegotiation completes and the MAC reports "Link is Up -
10Gbps/Full", but the link collapses again about 0.7 s later while the
media side keeps advertising 10G. The ladder retries every carrier grace
window and each retry buys less than a second of carrier, so DHCP never
completes.

A cold boot never shows this: rtl826x_config_init() (vendor soft reset,
firmware patch table, board SDS mode) runs immediately before the first
autonegotiation, and the link then holds for hours. Reproduce that
sequence once after a physical unplug: note the link loss, then run the
full init from read_status() - phylib never calls config_aneg() or
config_init() on the hot-plug path - and re-program autonegotiation
afterwards, because the vendor reset restores power-on advertisement.

Also stop the USXGMII reset work from resetting the block while the MAC
carrier is already up. Its trigger is the indirect SerDes link-status
readback, which can lag a healthy link; resetting on that stale value
drops a working link shortly after it comes up.

Finally shorten the carrier grace window so a link that still fails to
hold is retried every ~20 s instead of every ~127 s.

Signed-off-by: zhangjianguo <janegle@gmail.com>
---
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -25,8 +25,12 @@
 
 #include "realtek.h"
 
-/* Let the HZ-driven PCS poll observe the new in-band word before retrying. */
-#define RTL826X_RTK_SERDES_CARRIER_GRACE_POLLS	120
+/* Let the HZ-driven PCS poll observe the new in-band word before retrying.
+ * Keep the window short: a hot-plugged link either holds within a few
+ * seconds or never will, and a two-minute backoff keeps the port dead far
+ * longer than DHCP can tolerate.
+ */
+#define RTL826X_RTK_SERDES_CARRIER_GRACE_POLLS	20
 
 #define RTL8201F_IER				0x13
 
@@ -3299,6 +3303,14 @@
 	if (READ_ONCE(priv->sds_work_disabled))
 		return;
 
+	/* The indirect SerDes status readback can lag a healthy link, so a
+	 * clear link bit does not prove the block needs a reset. Never reset
+	 * it while the MAC carrier is up: that drops a working link about a
+	 * second after it came up.
+	 */
+	if (phydev->attached_dev && netif_carrier_ok(phydev->attached_dev))
+		return;
+
 	val = rtl826x_phy_patch_sds_get(phydev, RTL826X_SDS_PAGE_LINK,
 					RTL826X_SDS_REG_LINK);
 	if (val < 0)
@@ -3331,6 +3343,17 @@
 {
 	struct rtl826x_priv *priv = phydev->priv;
 
+	/* Unplugging the cable can leave the PHY firmware wedged: the next
+	 * autonegotiation completes, the MAC reports 10G, and the link then
+	 * collapses within a second while the media side keeps advertising
+	 * the same speed. Only a fresh init sequence clears that state, which
+	 * is why a cold boot holds the link and a hot-plug does not.
+	 */
+	if (phydev->link)
+		priv->ever_linked = true;
+	else if (priv->ever_linked)
+		priv->reinit_pending = true;
+
 	if (phydev->state != PHY_RUNNING) {
 		if (!READ_ONCE(priv->sds_work_disabled)) {
 			WRITE_ONCE(priv->sds_work_disabled, true);
@@ -3690,6 +3713,8 @@
 	return 0;
 }
 
+static int rtl826x_config_intr(struct phy_device *phydev);
+
 static int rtl826x_read_status(struct phy_device *phydev)
 {
 	struct rtl826x_priv *priv = phydev->priv;
@@ -3697,6 +3722,23 @@
 	int status;
 	int ret;
 
+	/* Reproduce the cold-boot sequence once after a physical unplug:
+	 * phylib never re-runs config_init() on the hot-plug path, and the
+	 * flow_s pulse ladder alone cannot lift the wedged firmware. The
+	 * vendor reset restores power-on advertisement, so re-program AN
+	 * right after it.
+	 */
+	if (priv && priv->reinit_pending) {
+		priv->reinit_pending = false;
+		if (rtl826x_config_init(phydev)) {
+			phydev_warn(phydev, "hot-plug re-init failed\n");
+		} else {
+			if (phydev->irq > 0)
+				rtl826x_config_intr(phydev);
+			rtl826x_config_aneg(phydev);
+		}
+	}
+
 	phydev->speed = SPEED_UNKNOWN;
 	phydev->duplex = DUPLEX_UNKNOWN;
 	phydev->pause = 0;
--- a/drivers/net/phy/realtek/realtek.h
+++ b/drivers/net/phy/realtek/realtek.h
@@ -22,6 +22,8 @@
 	u8 rtk_serdes_carrier_polls;
 	bool enable_pma_low_power:1;
 	bool patch_rtk_serdes:1;
+	bool reinit_pending:1;
+	bool ever_linked:1;
 	struct phy_device *phydev;
 	struct delayed_work sds_work;
 	bool sds_work_disabled;
