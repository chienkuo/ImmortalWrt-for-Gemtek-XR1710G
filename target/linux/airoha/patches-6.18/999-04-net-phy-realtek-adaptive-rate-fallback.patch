From: zhangjianguo <janegle@gmail.com>
Subject: [PATCH] net: phy: realtek: adaptive rate fallback when 10G cannot hold

Keep 10G advertised, but when the link repeatedly fails to hold after
a recovery, step the copper AN advertising down 10G -> 5G -> 2.5G -> 1G
and restart AN. Only wedge episodes starting 5-30 s after a carrier
recovery count as a failed hold: earlier episodes are initial
negotiation churn (boot, re-AN) and are ignored. The failed-hold
counter resets on a successful hold; a reboot restores the full
advertisement.

Signed-off-by: zhangjianguo <janegle@gmail.com>
---
--- a/drivers/net/phy/realtek/realtek.h
+++ b/drivers/net/phy/realtek/realtek.h
@@ -23,6 +23,9 @@
 	u8 rtk_serdes_full_resets;
 	unsigned long rtk_pulse_start_ts;
 	unsigned long rtk_lane_restart_ts;
+	u8 rtk_rate_step;
+	u8 rtk_failed_holds;
+	unsigned long rtk_hold_ts;
 	struct delayed_work lane_restart_work;
 	bool enable_pma_low_power:1;
 	bool patch_rtk_serdes:1;
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -3792,6 +3792,37 @@
 	schedule_delayed_work(&priv->lane_restart_work, msecs_to_jiffies(200));
 }
 
+/* Adaptive rate fallback: keep 10G advertised, but when the link
+ * repeatedly cannot hold after a recovery (new wedge within 30 s of
+ * the previous carrier recovery), step the copper AN advertising down
+ * 10G -> 5G -> 2.5G -> 1G. A reboot restores the full advertisement.
+ */
+static void rtl826x_step_down_rate(struct phy_device *phydev)
+{
+	struct rtl826x_priv *priv = phydev->priv;
+	static const int steps[] = {
+		ETHTOOL_LINK_MODE_10000baseT_Full_BIT,
+		ETHTOOL_LINK_MODE_5000baseT_Full_BIT,
+		ETHTOOL_LINK_MODE_2500baseT_Full_BIT,
+		ETHTOOL_LINK_MODE_1000baseT_Full_BIT,
+	};
+	int i;
+
+	if (priv->rtk_rate_step >= ARRAY_SIZE(steps) - 1)
+		return;
+
+	for (i = 0; i <= priv->rtk_rate_step; i++)
+		linkmode_clear_bit(steps[i], phydev->advertising);
+
+	priv->rtk_rate_step++;
+	priv->rtk_failed_holds = 0;
+	priv->rtk_hold_ts = 0;
+
+	phydev_info(phydev, "link cannot hold, stepping rate down to step %u\n",
+		    priv->rtk_rate_step);
+	phy_config_aneg(phydev);
+}
+
 static int rtl826x_read_status(struct phy_device *phydev)
 {
 	struct rtl826x_priv *priv = phydev->priv;
@@ -3840,8 +3871,21 @@
 	 * PCS/USXGMII lane; a phylink restart (pcs_config -> JCPLL VCO
 	 * recal) does.
 	 */
-	if (priv->rtk_serdes_pulse_count && !priv->rtk_pulse_start_ts)
+	if (priv->rtk_serdes_pulse_count && !priv->rtk_pulse_start_ts) {
 		priv->rtk_pulse_start_ts = jiffies;
+		if (priv->rtk_hold_ts &&
+		    time_before(jiffies, priv->rtk_hold_ts + 30 * HZ)) {
+			/* Episodes starting within 5 s of the recovery are
+			 * initial negotiation churn (boot, re-AN), not a
+			 * failed hold.
+			 */
+			if (!time_before(jiffies, priv->rtk_hold_ts + 5 * HZ) &&
+			    ++priv->rtk_failed_holds >= 2)
+				rtl826x_step_down_rate(phydev);
+		} else {
+			priv->rtk_failed_holds = 1;
+		}
+	}
 	else if (!priv->rtk_serdes_pulse_count)
 		priv->rtk_pulse_start_ts = 0;
 
@@ -3919,6 +3963,7 @@
 				    "RTK SerDes carrier recovered after %u flow_s pulse(s)\n",
 				    priv->rtk_serdes_pulse_count);
 			priv->rtk_pulse_start_ts = 0;
+			priv->rtk_hold_ts = jiffies;
 			priv->rtk_serdes_state = RTL826X_RTK_SERDES_IDLE;
 			return 0;
 		}
