From: naoki66 <naoki66@qq.com>
Subject: [PATCH] dawn 6ghz band (rebased for dawn 2026-11-11)

Upstream DAWN cf43b0f1 gained native 6 GHz band support
(band_config_name "802_11ax", max_band_freq 7125, 3-wide metric
arrays). The old C-source hunk (enum reordering in datastorage.h)
collides with that work; only the uci-defaults metric section is still
needed, under the native band name 802_11ax.
---
diff --git a/net/dawn/files/dawn.config b/net/dawn/files/dawn.config
index 1154d2b14..e5deb8665 100644
--- a/net/dawn/files/dawn.config
+++ b/net/dawn/files/dawn.config
@@ -78,3 +78,22 @@ config metric '802_11a'
 	option max_chan_util_val '170'
 	option rssi_weight '0'
 	option rssi_center '-70'
+
+# 6 GHz band metrics — dawn 2026-11-11+ natively maps the third band
+# (band_config_name "802_11ax") to frequencies up to 7125 MHz.
+config metric '802_11ax'
+	option initial_score '100'
+	option ht_support '5'
+	option vht_support '5'
+	option no_ht_support '0'
+	option no_vht_support '0'
+	option rssi '15'
+	option rssi_val '-60'
+	option low_rssi_val '-80'
+	option low_rssi '-15'
+	option chan_util '0'
+	option chan_util_val '140'
+	option max_chan_util '-15'
+	option max_chan_util_val '170'
+	option rssi_weight '0'
+	option rssi_center '-70'
